{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Customer's name"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer's email address"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer's phone number"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en",
      "description": "Conversation language"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "resolved",
        "pending"
      ],
      "default": "active",
      "description": "Conversation status"
    },
    "category": {
      "type": "string",
      "enum": [
        "faq",
        "order_tracking",
        "support",
        "product_recommendation",
        "general"
      ],
      "default": "general",
      "description": "Type of inquiry"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "last_message": {
      "type": "string",
      "description": "Last message in conversation"
    }
  },
  "required": [
    "customer_name",
    "session_id"
  ]
}