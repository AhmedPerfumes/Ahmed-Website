{
  "name": "Product",
  "type": "object",
  "properties": {
    "name_en": {
      "type": "string",
      "description": "Product name in English"
    },
    "name_ar": {
      "type": "string",
      "description": "Product name in Arabic"
    },
    "description_en": {
      "type": "string",
      "description": "Product description in English"
    },
    "description_ar": {
      "type": "string",
      "description": "Product description in Arabic"
    },
    "price": {
      "type": "number",
      "description": "Product price"
    },
    "currency": {
      "type": "string",
      "default": "AED",
      "description": "Price currency"
    },
    "category": {
      "type": "string",
      "enum": [
        "perfumes",
        "oud",
        "bakhoor",
        "oils",
        "sets",
        "accessories"
      ],
      "description": "Product category"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "product_url": {
      "type": "string",
      "description": "Link to product page"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product tags for recommendations"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a featured product"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "limited"
      ],
      "default": "in_stock"
    }
  },
  "required": [
    "name_en",
    "price",
    "category"
  ]
}