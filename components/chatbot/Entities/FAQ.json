{
  "name": "FAQ",
  "type": "object",
  "properties": {
    "question_en": {
      "type": "string",
      "description": "FAQ question in English"
    },
    "question_ar": {
      "type": "string",
      "description": "FAQ question in Arabic"
    },
    "answer_en": {
      "type": "string",
      "description": "FAQ answer in English"
    },
    "answer_ar": {
      "type": "string",
      "description": "FAQ answer in Arabic"
    },
    "category": {
      "type": "string",
      "enum": [
        "shipping",
        "returns",
        "products",
        "orders",
        "account",
        "payments"
      ],
      "description": "FAQ category"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords for matching questions"
    },
    "priority": {
      "type": "number",
      "default": 1,
      "description": "Display priority (higher = more important)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this FAQ is active"
    }
  },
  "required": [
    "question_en",
    "answer_en",
    "category"
  ]
}