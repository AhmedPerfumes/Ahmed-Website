{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "ID of the conversation this message belongs to"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "bot",
        "agent"
      ],
      "description": "Who sent the message"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "file",
        "product_card",
        "order_status"
      ],
      "default": "text",
      "description": "Type of message"
    },
    "metadata": {
      "type": "object",
      "description": "Additional data like product info, order details, etc."
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "ar"
      ],
      "default": "en"
    }
  },
  "required": [
    "conversation_id",
    "sender_type",
    "content"
  ]
}